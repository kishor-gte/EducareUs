# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/educarrus_db?schema=public

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_educarrus_production_ready_2026
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Platform Fees & Defaults
PLATFORM_FEE_PERCENTAGE=0.00

# Country State City API Key (from https://countrystatecity.in/)
CSC_API_KEY=""

# ==============================================================================
# EMAIL (SMTP) CONFIGURATION FOR OTP VERIFICATION & NOTIFICATIONS
# ==============================================================================
# Option 1: Gmail (Recommended for quick testing)
#   1. Set SMTP_HOST=smtp.gmail.com
#   2. Set SMTP_PORT=587
#   3. Set SMTP_SECURE=false
#   4. Set SMTP_USER=your_email@gmail.com
#   5. In your Google Account: Security -> 2-Step Verification -> App Passwords
#      Generate a 16-character App Password (e.g. "abcd efgh ijkl mnop")
#   6. Set SMTP_PASS=your_16_char_app_password
#
# Option 2: Custom Webmail / Hostinger / SendGrid / Brevo / Outlook
#   Set your provider's SMTP Host, Port, User, and Password.
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Educarrus Foundation <noreply@educareus.org>"
