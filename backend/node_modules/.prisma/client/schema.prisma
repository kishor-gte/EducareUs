datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DONOR
  BENEFICIARY
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  SYSTEM
  DONATION
  VERIFICATION
  SECURITY
  SUPPORT
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  fullName           String
  phone              String?
  role               Role               @default(DONOR)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isSuspended        Boolean            @default(false)
  twoFactorEnabled   Boolean            @default(false)
  avatarUrl          String?
  location           String?
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  donations             Donation[]            @relation("UserDonations")
  verificationRequests  VerificationRequest[] @relation("UserVerificationRequests")
  reviewedVerifications VerificationRequest[] @relation("AdminReviewedVerifications")
  withdrawalRequests    WithdrawalRequest[]   @relation("BeneficiaryWithdrawals")
  reviewedWithdrawals   WithdrawalRequest[]   @relation("AdminReviewedWithdrawals")
  supportTickets        SupportTicket[]       @relation("UserSupportTickets")
  assignedTickets       SupportTicket[]       @relation("AdminAssignedTickets")
  notifications         Notification[]
  auditLogs             AuditLog[]            @relation("UserAuditLogs")
  enquiries             Enquiry[]             @relation("UserEnquiries")
  authoredBlogs         Blog[]                @relation("AuthorBlogs")
  updatedPages          SitePage[]            @relation("AdminUpdatedPages")
  publishedRevisions    PageRevision[]        @relation("AdminPublishedRevisions")
  createdFaqs           FAQ[]                 @relation("UserCreatedFAQs")
  reviews               Review[]              @relation("UserReviews")

  @@index([role])
  @@index([verificationStatus])
  @@index([email])
}

model Donation {
  id                String         @id @default(uuid())
  donorId           String?
  amount            Decimal        @db.Decimal(12, 2)
  tipAmount         Decimal        @default(0.00) @db.Decimal(12, 2)
  donorName         String? // For guest / anonymous donations
  donorEmail        String? // For receipt & verification
  isAnonymous       Boolean        @default(false)
  purpose           String? // Education Grant, Scholarship Support
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?        @unique
  razorpaySignature String?
  paymentMethod     String? // UPI, NetBanking, Card, etc.
  status            DonationStatus @default(PENDING)
  receiptNumber     String         @unique
  failureReason     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  donor User? @relation("UserDonations", fields: [donorId], references: [id], onDelete: SetNull)

  @@index([donorId])
  @@index([status])
  @@index([createdAt])
}

model VerificationRequest {
  id              String             @id @default(uuid())
  userId          String
  documentType    String // Aadhaar, College ID, Fee Structure, Income Certificate, Marks Card
  documentUrl     String
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?

  // Relations
  user       User  @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AdminReviewedVerifications", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model WithdrawalRequest {
  id                String           @id @default(uuid())
  beneficiaryId     String
  amount            Decimal          @db.Decimal(12, 2)
  bankAccountName   String
  bankAccountNumber String
  bankIfsc          String
  bankName          String
  status            WithdrawalStatus @default(PENDING)
  reviewedById      String?
  rejectionReason   String?
  transactionRef    String?
  requestedAt       DateTime         @default(now())
  processedAt       DateTime?

  // Relations
  beneficiary User  @relation("BeneficiaryWithdrawals", fields: [beneficiaryId], references: [id], onDelete: Cascade)
  reviewedBy  User? @relation("AdminReviewedWithdrawals", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([beneficiaryId])
  @@index([status])
}

model SupportTicket {
  id              String         @id @default(uuid())
  userId          String
  subject         String
  message         String         @db.Text
  category        String // Admissions, Verification, Technical, Billing, General
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  assignedAdminId String?
  resolutionNotes String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  user          User  @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User? @relation("AdminAssignedTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([priority])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String // APPROVE_REQUEST, VERIFY_DOCUMENT, UPDATE_SETTINGS, etc.
  entityType    String // User, Donation, VerificationRequest, etc.
  entityId      String?
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  actor User? @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. PLATFORM_NAME, PLATFORM_FEE_PERCENT, etc.
  value       Json
  category    String   @default("GENERAL") // GENERAL, PAYMENT, SECURITY, COMPLIANCE
  description String?
  updatedAt   DateTime @updatedAt
}

model Enquiry {
  id                    String   @id @default(uuid())
  userId                String?
  fullName              String
  email                 String
  phone                 String?
  location              String?
  highestEducation      String
  interestedCourse      String
  preferredInstitutions String?
  queryDetails          String   @db.Text
  adminNotes            String?  @db.Text
  currentStream         String?
  status                String   @default("NEW")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User? @relation("UserEnquiries", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([email])
}

model Blog {
  id               String            @id @default(uuid())
  title            String
  slug             String            @unique
  excerpt          String            @db.Text
  content          String            @db.Text
  publishedContent String?           @db.Text
  category         String            @default("General")
  tags             String[]          @default([])
  authorName       String
  authorId         String?
  coverImage       String?
  coverImageAlt    String?
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  status           PublicationStatus @default(DRAFT)
  isFeatured       Boolean           @default(false)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  author User? @relation("AuthorBlogs", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

model SitePage {
  id               String            @id @default(uuid())
  slug             String            @unique // e.g. "terms-and-conditions", "privacy-policy"
  title            String
  introduction     String?           @db.Text
  content          String            @db.Text
  publishedContent String?           @db.Text
  effectiveDate    String?
  version          String            @default("1.0")
  metaTitle        String?
  metaDescription  String?
  status           PublicationStatus @default(PUBLISHED)
  lastUpdatedBy    String?
  lastUpdatedById  String?
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  updater   User?          @relation("AdminUpdatedPages", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  revisions PageRevision[]

  @@index([slug])
  @@index([status])
}

model PageRevision {
  id            String   @id @default(uuid())
  pageId        String
  version       String
  title         String
  introduction  String?  @db.Text
  content       String   @db.Text
  effectiveDate String?
  publishedBy   String?
  publishedById String?
  publishedAt   DateTime @default(now())

  page      SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  publisher User?    @relation("AdminPublishedRevisions", fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([publishedAt])
}

model FAQ {
  id           String            @id @default(uuid())
  question     String
  answer       String            @db.Text
  category     String            @default("General")
  displayOrder Int               @default(0)
  status       PublicationStatus @default(PUBLISHED)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  createdBy User? @relation("UserCreatedFAQs", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([status])
  @@index([displayOrder])
}

model Course {
  id                     String            @id @default(uuid())
  name                   String
  fullName               String?
  slug                   String            @unique
  category               String
  duration               String
  shortDescription       String            @db.Text
  detailedDescription    String?           @db.Text
  imageUrl               String?
  imageAlt               String?
  institutionDisplayText String?
  buttonText             String            @default("Explore Guidance")
  buttonDestination      String?
  showOnHomepage         Boolean           @default(false)
  isFeatured             Boolean           @default(false)
  displayOrder           Int               @default(0)
  publicationStatus      PublicationStatus @default(DRAFT)
  draftContent           String?           @db.Text
  publishedContent       String?           @db.Text
  publishedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  // Many-to-many relationship with College
  colleges College[] @relation("CourseColleges")

  @@index([slug])
  @@index([category])
  @@index([publicationStatus])
  @@index([showOnHomepage])
  @@index([displayOrder])
}

model College {
  id                    String   @id @default(uuid())
  name                  String
  logoUrl               String?
  imageUrl              String?
  city                  String?
  state                 String?
  country               String?  @default("India")
  institutionType       String?
  universityAffiliation String?
  description           String?  @db.Text
  websiteUrl            String?
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Many-to-many relationship with Course
  courses Course[] @relation("CourseColleges")

  @@index([name])
  @@index([status])
}

model HomepageSection {
  id            String            @id @default(uuid())
  key           String            @unique
  title         String?
  draftData     Json
  publishedData Json?
  status        PublicationStatus @default(DRAFT)
  version       String            @default("1.0")
  publishedAt   DateTime?
  lastUpdatedBy String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([key])
  @@index([status])
}

model Review {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation("UserReviews", fields: [userId], references: [id], onDelete: SetNull)
  name        String
  initials    String?
  role        String   @default("Verified Student Scholar")
  institution String?
  rating      Int      @default(5)
  comment     String   @db.Text
  problemType String?
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isApproved])
  @@index([createdAt])
}

model TrustMember {
  id             String   @id @default(uuid())
  name           String
  specialization String
  description    String   @db.Text
  image          String?
  tag            String?  @default("Academic Leader")
  badgeColor     String?  @default("bg-[#FFB52E] text-[#172033]")
  linkedinUrl    String?
  twitterUrl     String?
  githubUrl      String?
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
}
